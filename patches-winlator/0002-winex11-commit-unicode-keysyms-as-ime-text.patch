+++ b/dlls/winex11.drv/xim.c
@@ -118,6 +118,35 @@ void xim_set_result_string( HWND hwnd, const char *str, UINT count )
     free( output );
 }
 
+/* WinRunner: commit the character a Unicode keysym (0x01000000 | code point) stands for, as an IME
+ * result. The container's X server has no XKB extension and no input method, so XLookupString()
+ * returns no text for these keysyms and the key event would otherwise be dropped (no vkey). Going
+ * through the IME, as an XIM commit would, reaches games that read text with
+ * ImmGetCompositionString (Diablo II takes Korean only that way) as well as plain WM_CHAR ones. */
+void xim_commit_unicode_keysym( HWND hwnd, KeySym keysym )
+{
+    unsigned int cp = keysym & 0x00ffffff;
+    WCHAR str[3];
+
+    if (cp >= 0x110000) return;
+    if (cp >= 0x10000)
+    {
+        cp -= 0x10000;
+        str[0] = 0xd800 | (cp >> 10);
+        str[1] = 0xdc00 | (cp & 0x3ff);
+        str[2] = 0;
+    }
+    else
+    {
+        str[0] = cp;
+        str[1] = 0;
+    }
+
+    TRACE( "hwnd %p, keysym %lx -> %s
+", hwnd, keysym, debugstr_w(str) );
+    post_ime_update( hwnd, 0, NULL, str );
+}
