+/* WINE_DDRAW_WINDOWED_GDI=1: in non-exclusive (windowed) mode, keep the GL
+ * drawable on a hidden window and copy primary surface updates into the
+ * application's window with GDI. Presenting the primary through the swapchain
+ * puts a GL drawable over the whole clipper/cooperative window, which hides
+ * GDI child windows inside it (Gensou Suikoden draws its field with ddraw and
+ * its message and status windows with GDI, all inside one frame window). */
+BOOL ddraw_windowed_gdi_enabled(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+    {
+        char value[8];
+        DWORD len = GetEnvironmentVariableA("WINE_DDRAW_WINDOWED_GDI", value, sizeof(value));
+
+        enabled = len && len < sizeof(value) && value[0] != '0';
+        if (enabled)
+            FIXME("Copying windowed primary surface updates with GDI (WINE_DDRAW_WINDOWED_GDI).
+");
+    }
+    return enabled;
+}
