diff --git a/dlls/ddraw/surface.c b/dlls/ddraw/surface.c
index 545c767..89de326 100644
--- a/dlls/ddraw/surface.c
+++ b/dlls/ddraw/surface.c
@@ -58,6 +58,63 @@ static BOOL ddraw_gdi_is_front(struct ddraw *ddraw)
  * applications from drawing to the screen while we've locked the frontbuffer.
  * We'd like to do this in wined3d instead, but for that to work wined3d needs
  * to support windowless rendering first. */
+/* Copy a primary surface update to or from the application's window with
+ * GDI, see ddraw_windowed_gdi_enabled(). The windowed primary surface uses
+ * screen coordinates. */
+static HRESULT ddraw_surface_update_window_gdi(struct ddraw_surface *surface,
+        struct wined3d_texture *wined3d_texture, int x, int y, int w, int h, BOOL read)
+{
+    struct ddraw *ddraw = surface->ddraw;
+    POINT origin = {0, 0};
+    HWND window = NULL;
+    HDC surface_dc, dst_dc;
+    HRESULT hr;
+    BOOL ret;
+
+    if (surface->clipper && ddraw_clipper_is_valid(surface->clipper))
+        window = surface->clipper->window;
+    if (!window)
+        window = ddraw->dest_window;
+    if (window && !IsWindow(window))
+        window = NULL;
+
+    if (FAILED(hr = wined3d_texture_get_dc(wined3d_texture, surface->sub_resource_idx, &surface_dc)))
+    {
+        ERR("Failed to get surface DC, hr %#lx.
+", hr);
+        return hr;
+    }
+    if (surface->palette)
+        wined3d_palette_apply_to_dc(surface->palette->wined3d_palette, surface_dc);
+
+    if (window)
+        ClientToScreen(window, &origin);
+    if (!(dst_dc = GetDC(window)))
+    {
+        wined3d_texture_release_dc(wined3d_texture, surface->sub_resource_idx, surface_dc);
+        ERR("Failed to get window DC.
+");
+        return E_FAIL;
+    }
+
+    if (read)
+        ret = BitBlt(surface_dc, x, y, w, h, dst_dc, x - origin.x, y - origin.y, SRCCOPY);
+    else
+        ret = BitBlt(dst_dc, x - origin.x, y - origin.y, w, h, surface_dc, x, y, SRCCOPY);
+
+    ReleaseDC(window, dst_dc);
+    wined3d_texture_release_dc(wined3d_texture, surface->sub_resource_idx, surface_dc);
+
+    if (!ret)
+    {
+        ERR("Failed to blit to/from window %p.
+", window);
+        return E_FAIL;
+    }
+
+    return DD_OK;
+}
