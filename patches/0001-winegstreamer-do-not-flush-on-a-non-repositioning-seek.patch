diff -u -r a/dlls/winegstreamer/quartz_parser.c b/dlls/winegstreamer/quartz_parser.c
--- a/dlls/winegstreamer/quartz_parser.c	2026-09-22 13:13:18.114219100 +0900
+++ b/dlls/winegstreamer/quartz_parser.c	2026-09-22 13:13:18.122840200 +0900
@@ -1968,6 +1968,18 @@
         return S_OK;
     }
 
+    /* A caller that passes AM_SEEKING_NoPositioning for the current position is
+     * explicitly asking us not to move it; typically it is only updating the
+     * stop position, which some applications do several times per second.
+     * There is nothing to discard in that case, and flushing is actively
+     * harmful: it drops every sample already queued downstream and restarts
+     * the GStreamer pipeline from wherever the demuxer has read ahead to,
+     * which is far beyond what has actually been rendered.  Playback then
+     * jumps forward by the size of the queue on every such call.  Handle it
+     * as a non-flushing seek instead. */
+    if ((current_flags & AM_SEEKING_PositioningBitsMask) == AM_SEEKING_NoPositioning)
+        current_flags |= AM_SEEKING_NoFlush;
+
     if (!(current_flags & AM_SEEKING_NoFlush))
     {
         for (i = 0; i < filter->source_count; ++i)
diff -u -r a/dlls/winegstreamer/wg_parser.c b/dlls/winegstreamer/wg_parser.c
--- a/dlls/winegstreamer/wg_parser.c	2026-09-22 13:13:18.115214800 +0900
+++ b/dlls/winegstreamer/wg_parser.c	2026-09-22 13:13:18.128839100 +0900
@@ -471,7 +471,14 @@
         flags |= GST_SEEK_FLAG_FLUSH;
 
     if ((start_flags & AM_SEEKING_PositioningBitsMask) == AM_SEEKING_NoPositioning)
+    {
+        /* Keeping the current position and flushing are contradictory: a
+         * flushing seek resumes from the pipeline's read-ahead point rather
+         * than from what has been rendered, so it silently skips forward.
+         * Never discard the pipeline's data when the position is not moving. */
         start_type = GST_SEEK_TYPE_NONE;
+        flags &= ~GST_SEEK_FLAG_FLUSH;
+    }
     if ((stop_flags & AM_SEEKING_PositioningBitsMask) == AM_SEEKING_NoPositioning)
         stop_type = GST_SEEK_TYPE_NONE;
 
